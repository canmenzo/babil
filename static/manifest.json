{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_ext_name__",
  "version": "0.8.4",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "minimum_chrome_version": "138",
  "permissions": ["tabCapture", "offscreen", "scripting", "activeTab", "storage", "unlimitedStorage", "tts"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Babil", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "128": "icons/128.png" },
  "commands": {
    "toggle-captions": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "__MSG_cmd_toggle__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
